// Cloudflare: publica la web estática que genera `npm run build` (carpeta dist). Sin servidor.
// Producción (rama main): https://pizarra-digital.<subdominio>.workers.dev · cada otra rama, su vista previa.
{
  "name": "pizarra-digital",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
